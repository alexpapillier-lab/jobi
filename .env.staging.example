# Staging – druhý projekt Supabase, na kterém se zkouší migrace, edge funkce
# a agenti dřív, než jdou na produkci. Postup: docs/STAGING.md.
#
#   cp .env.staging.example .env.staging     # .env.staging je v .gitignore
#
# Soubor čtou dvě věci:
#   * Vite v režimu staging (npm run dev:staging, dev:web:staging,
#     tauri:dev:staging). Do aplikace se dostanou JEN proměnné VITE_* –
#     heslo k databázi níž do balíčku nikdy nepřijde.
#   * skripty ve scripts/staging/ (obnova z produkce, migrace na staging).
# .env zůstává produkci; tenhle soubor ho v režimu staging jen přebije.

# --- Aplikace (Dashboard stagingu → Project Settings → API) ---
VITE_SUPABASE_URL=https://<STAGING_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Stejné UUID jako v .env – ID uživatelů se obnovou ze zálohy nemění.
# VITE_ROOT_OWNER_ID=
# Aplikace ukáže štítek STAGING a do titulku okna přidá [STAGING].
VITE_JOBI_PROSTREDI=staging

# --- Skripty (scripts/staging/) ---
# Ref projektu stagingu: 20 malých písmen z adresy projektu v Dashboardu.
# NIKDY ijtvcgolsdsrquqbvjrz (produkce) – skripty to odmítnou.
STAGING_REF=
# Connection string stagingu i s heslem: Dashboard → Connect → Session pooler
# (port 5432). Zvláštní znaky v hesle musí být procentově zakódované
# (@ → %40, # → %23 …), jinak ho supabase db push nepřečte. Hodnoty s heslem
# drž v jednoduchých uvozovkách – soubor načítá i shell.
STAGING_DB_URL='postgresql://postgres.<STAGING_REF>:<HESLO>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres'
# Heslo, které po obnově z produkce dostanou všichni uživatelé stagingu
# (e2e@jobi.test, e2e-technik@jobi.test i anonymizovaní uzivatel-N@staging.jobi.test).
# Aspoň 12 znaků; vygeneruj: openssl rand -base64 18
STAGING_TEST_PASSWORD=''
# E-maily, které se při obnově neanonymizují (čárkou oddělené) – např. tvůj,
# ať se na staging přihlásíš jako ty. Heslo je i tak STAGING_TEST_PASSWORD.
# STAGING_PONECHAT_EMAILY=
# Heslo k šifrované záloze z GitHubu (secret BACKUP_PASSPHRASE). Jen pro
# obnovu z artefaktu (výchozí zdroj); pro --lokalni není potřeba.
# BACKUP_PASSPHRASE=
# Nasazení edge funkcí bez `supabase login` (Dashboard → Account → Access Tokens).
# SUPABASE_ACCESS_TOKEN=
# Nechat na stagingu běžet naplánované úlohy (pg_cron). Výchozí je vypnout.
# STAGING_CRON=zapnuto

{
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "2.5.7",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  },
  "name": "jobi",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run lint && vite build",
    "build:all": "bash scripts/build-jobi-and-jobidocs.sh",
    "build:prod": "npm run typecheck && vite build",
    "build:site": "bash scripts/build-site.sh",
    "build:web": "npm run typecheck && vite build --config vite.config.web.ts",
    "db:migrate": "npx supabase db push",
    "db:migrate:local": "npx supabase migration up",
    "dev": "vite",
    "dev:check": "concurrently \"vite\" \"tsc --noEmit --watch\"",
    "dev:web": "vite --config vite.config.web.ts",
    "gen-dmg-background": "node scripts/gen-dmg-background.js",
    "generate-latest-json": "bash scripts/generate-jobi-latest-json.sh",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=9999",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts",
    "tauri": "tauri",
    "tauri:build": "npm run build:prod && tauri build",
    "tauri:build:universal": "bash scripts/build-universal.sh",
    "tauri:build:universal:signed": "bash scripts/build-universal-signed.sh",
    "tauri:dev:check": "concurrently \"npm run tauri dev\" \"tsc --noEmit --watch\"",
    "test": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run src/lib/__integration__",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "velikosti": "node scripts/velikosti.mjs src/pages/*.tsx jobidocs/src/App.tsx"
  },
  "type": "module",
  "version": "0.2.4"
}